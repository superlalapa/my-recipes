{% set t = i18n.strings[lang or "en"] %}
{% set other = i18n.strings[t.other] %}
{%- set switchUrl = other.home -%}
{#- altReal distinguishes a genuine counterpart page from a fallback to the
    other language's home, so hreflang is only claimed when it is reciprocal. -#}
{%- set altReal = false -%}
{%- if translationKey and collections.translations[translationKey] and collections.translations[translationKey][t.other] -%}
  {%- set switchUrl = collections.translations[translationKey][t.other] -%}
  {%- set altReal = true -%}
{%- elif altUrl -%}
  {%- set switchUrl = altUrl -%}
  {%- set altReal = true -%}
{%- endif -%}
<!doctype html>
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {{ t.siteTitle }}{% else %}{{ t.siteTitle }}{% endif %}</title>
<meta name="description" content="{{ description or t.siteDescription }}">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="googlebot" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="{{ t.siteTitle }}">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icon-180.png">
<link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
{% if altReal %}<link rel="alternate" hreflang="{{ t.code }}" href="{{ site.origin }}{{ page.url | url }}">
<link rel="alternate" hreflang="{{ other.code }}" href="{{ site.origin }}{{ switchUrl | url }}">
<link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ (page.url if t.code == i18n.list[0].code else switchUrl) | url }}">{% endif %}
<meta property="og:site_name" content="{{ t.siteTitle }}">
<meta property="og:locale" content="{{ t.code }}">
<meta property="og:type" content="{% if category %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or t.siteTitle }}">
<meta property="og:description" content="{{ description or t.siteDescription }}">
<meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
{% if imageUrl %}<meta property="og:image" content="{% if "//" in imageUrl %}{{ imageUrl }}{% else %}{{ site.origin }}{{ imageUrl | url }}{% endif %}">{% endif %}
<meta name="twitter:card" content="{% if imageUrl %}summary_large_image{% else %}summary{% endif %}">
<link rel="stylesheet" href="/assets/style.css?v={{ build.stamp }}">
<script>
window.SITE_BASE = {{ ("/" | url) | jsonify | safe }};
window.SITE_LANG = {{ t.code | jsonify | safe }};
window.SEARCH_INDEX = {{ (((t.home + "search-index.json") | url) + "?v=" + build.stamp) | jsonify | safe }};
</script>
</head>
<body>
<a class="skip" href="#main">{{ t.skipToContent }}</a>

<header class="topbar">
  <a class="brand" href="{{ t.home }}">
    <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/></svg>
    <span class="brand-name">{{ t.siteTitle }}</span>
  </a>
  <div class="topbar-actions">
    <a class="lang-btn" href="{{ switchUrl }}" lang="{{ other.htmlLang }}" hreflang="{{ other.code }}">{{ other.code | upper }}</a>
    <button type="button" class="icon-btn" data-search-open aria-label="{{ t.searchOpen }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
    </button>
  </div>
</header>

<main id="main">
  {{ content | safe }}
</main>

<footer class="sitefoot">
  <nav class="foot-nav">
    <a href="{{ t.home }}">{{ t.navHome }}</a>
    <a href="{{ t.home }}recipes/">{{ t.navAll }}</a>
    <a href="{{ switchUrl }}" lang="{{ other.htmlLang }}">{{ t.switchTo }}</a>
    <a href="{{ site.repo }}">{{ t.navSource }}</a>
  </nav>
  <p>{{ t.tagline }}</p>
</footer>

<div class="search-layer" data-search-layer hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="{{ t.searchOpen }}">
    <div class="search-head">
      <input type="search" data-search-input placeholder="{{ t.searchPlaceholder }}"
             autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="{{ t.searchOpen }}">
      <button type="button" class="text-btn" data-search-close>{{ t.searchClose }}</button>
    </div>
    <ul class="search-results" data-search-results></ul>
    <p class="search-empty" data-search-empty hidden>{{ t.searchEmpty }}</p>
  </div>
</div>

<script src="/assets/app.js?v={{ build.stamp }}" defer></script>
</body>
</html>
